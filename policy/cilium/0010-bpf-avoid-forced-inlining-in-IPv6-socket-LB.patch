From ff47c406a16036cc570ec9e0c4192fcc71c9198d Mon Sep 17 00:00:00 2001
From: l1b0k <libokang.lbk@alibaba-inc.com>
Date: Sat, 19 Sep 2026 15:01:07 +0800
Subject: [PATCH 10/11] bpf: avoid forced inlining in IPv6 socket LB

With IPv4 and IPv6 enabled, cil_sock6_sendmsg can fail to load on
Linux 5.10 when host-only socket LB is enabled. Failure to load the
socket collection also breaks IPv4 hostNetwork access to ClusterIP
services.

Remove forced inlining from __sock6_xlate_fwd to work around the load
failure. Add complexity-test configurations for host-only and full
socket LB with both address families enabled. The precise rejection
path in the target ALinux kernel has not been established.

Validation with Clang 19.1.7 on Linux 6.8 changed both configurations
from load failure to success; IPv4-only and IPv6-only still passed.
On an IPv4 ACK cluster with ALinux 5.10.134-19.8.al8.x86_64, all 12
Pod and hostNetwork connectivity checks passed after the fix and again
after a policy restart. Socket programs were JITed on both nodes.
Real dual-stack connectivity, stress and soak testing remain uncovered.

Related: https://github.com/cilium/cilium/issues/38789#issuecomment-3696123974
Signed-off-by: l1b0k <libokang.lbk@alibaba-inc.com>
---
 bpf/bpf_sock.c                          | 6 ++++--
 bpf/complexity-tests/510/bpf_sock/3.txt | 9 +++++++++
 bpf/complexity-tests/510/bpf_sock/4.txt | 8 ++++++++
 3 files changed, 21 insertions(+), 2 deletions(-)
 create mode 100644 bpf/complexity-tests/510/bpf_sock/3.txt
 create mode 100644 bpf/complexity-tests/510/bpf_sock/4.txt

diff --git a/bpf/bpf_sock.c b/bpf/bpf_sock.c
index 63568ef897..5d16ea0296 100644
--- a/bpf/bpf_sock.c
+++ b/bpf/bpf_sock.c
@@ -986,8 +986,10 @@ int cil_sock6_pre_bind(struct bpf_sock_addr *ctx)
 }
 #endif /* ENABLE_HEALTH_CHECK */
 
-static __always_inline int __sock6_xlate_fwd(struct bpf_sock_addr *ctx,
-					     const bool udp_only)
+/* Do not force inline: host-only dual-stack socket LB can fail to load
+ * cil_sock6_sendmsg on Linux 5.10. See cilium/cilium#38789.
+ */
+static int __sock6_xlate_fwd(struct bpf_sock_addr *ctx, const bool udp_only)
 {
 #ifdef ENABLE_IPV6
 	union lb6_affinity_client_id id;
diff --git a/bpf/complexity-tests/510/bpf_sock/3.txt b/bpf/complexity-tests/510/bpf_sock/3.txt
new file mode 100644
index 0000000000..d1d78e3953
--- /dev/null
+++ b/bpf/complexity-tests/510/bpf_sock/3.txt
@@ -0,0 +1,9 @@
+-DSKIP_DEBUG=1
+-DENABLE_IPV4=1
+-DENABLE_IPV6=1
+-DENABLE_NODEPORT=1
+-DENABLE_SESSION_AFFINITY=1
+-DENABLE_SOCKET_LB_HOST_ONLY=1
+-DENABLE_SOCKET_LB_PEER=1
+-DENABLE_SERVICE_PROTOCOL_DIFFERENTIATION=1
+-DHOST_NETNS_COOKIE=1ULL
diff --git a/bpf/complexity-tests/510/bpf_sock/4.txt b/bpf/complexity-tests/510/bpf_sock/4.txt
new file mode 100644
index 0000000000..7affc1a2f8
--- /dev/null
+++ b/bpf/complexity-tests/510/bpf_sock/4.txt
@@ -0,0 +1,8 @@
+-DSKIP_DEBUG=1
+-DENABLE_IPV4=1
+-DENABLE_IPV6=1
+-DENABLE_NODEPORT=1
+-DENABLE_SESSION_AFFINITY=1
+-DENABLE_SOCKET_LB_PEER=1
+-DENABLE_SERVICE_PROTOCOL_DIFFERENTIATION=1
+-DHOST_NETNS_COOKIE=1ULL
